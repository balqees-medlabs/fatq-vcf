/*
 * fatq-vcf — germline WGS/WES pipeline: FASTQ → QC → align (GRCh38) → markdup → BQSR
 *             → HaplotypeCaller (GVCF, DRAGEN mode) → mito (GATK) → SV/CNV (Manta, CNVpytor, gCNV)
 *
 * Design: docs/PIPELINE_PLAN.md
 */

manifest {
    name            = 'fatq-vcf'
    author          = 'balqees-medlabs'
    description     = 'Germline WGS/WES pipeline from FASTQ to small-variant, mitochondrial and CNV/SV VCFs on GRCh38'
    homePage        = 'https://github.com/balqees-medlabs/fatq-vcf'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.04.0'
    version         = '0.1.0-dev'
}

nextflow.enable.strict = true

params {
    // ---- Input / output ----------------------------------------------------
    input                 = null            // samplesheet CSV (see assets/samplesheet.example.csv)
    outdir                = 'results'
    publish_dir_mode      = 'copy'

    // ---- Tool switches -----------------------------------------------------
    aligner               = 'bwamem3'       // bwamem3 (default, --compat=bwa-mem2) | bwamem2
    bwamem3_compat        = 'bwa-mem2'      // bwa-mem3 --compat level; set to '' to use native mode (NOT validated)
    skip_bqsr             = false
    skip_mito             = false
    skip_sv_cnv           = false
    skip_fastqc           = true            // fastp reports are the default QC; FastQC optional
    trim_reads            = true            // fastp adapter + poly-G trimming (light)
    scatter_count         = 20              // BQSR / HaplotypeCaller interval shards
    markdup_optical_dist  = 2500            // samtools markdup -d; 2500 patterned flow cells, 100 HiSeq
    wes_padding           = 100             // bp added around capture targets for BQSR / calling

    // ---- QC gates (sample is flagged, pipeline continues) ------------------
    max_contamination     = 0.03            // VerifyBamID2 FREEMIX
    min_mean_cov_wgs      = 25
    min_target_cov_wes    = 20
    min_target_frac_wes   = 0.90
    max_duplication       = 0.25

    // ---- Reference bundle (see conf/references.config) ----------------------
    refdir                = "${projectDir}/references/GRCh38"

    // ---- WES CNV panel of normals (GATK gCNV model dir); null = skip gCNV ---
    gcnv_model_dir        = null
    gcnv_ploidy_model_dir = null

    // ---- PREPARE_REFERENCES options -----------------------------------------
    prepare_references    = false           // run the one-off reference-bundle workflow instead of the pipeline
    test_data             = true            // also build HG002 chr20+chrM test set into tests/data/
    validation_data       = false           // also download HG002 30x WGS FASTQ (52 GB) for Phase 6

    // ---- Misc --------------------------------------------------------------
    help                  = false
    max_cpus              = 80
    max_memory            = '115.GB'
    max_time              = '72.h'
    trace_report_suffix   = new java.util.Date().format('yyyyMMdd_HHmmss')
}

includeConfig 'conf/base.config'
includeConfig 'conf/references.config'
includeConfig 'conf/containers.config'
includeConfig 'conf/modules.config'

// ---- Profiles -------------------------------------------------------------
profiles {
    docker {
        docker.enabled      = true
        // --network=host: this node's Docker bridge has no outbound route (host firewall); only the
        // reference-download steps need network, and host networking is harmless on a single node.
        docker.runOptions   = '-u $(id -u):$(id -g) --network=host'
        apptainer.enabled   = false
        singularity.enabled = false
    }
    apptainer {
        apptainer.enabled   = true
        apptainer.autoMounts = true
        apptainer.cacheDir  = "${projectDir}/.apptainer_cache"
        docker.enabled      = false
    }
    test     { includeConfig 'conf/test.config' }
    test_wes { includeConfig 'conf/test_wes.config' }
}

// ---- Execution on a single 80-core node ------------------------------------
executor {
    name    = 'local'
    cpus    = params.max_cpus
    memory  = params.max_memory
}

workDir = "${projectDir}/work"

// Remove intermediates after a successful run (a 30x WGS leaves 300-400 GB otherwise).
cleanup = true

// ---- Run reports ----------------------------------------------------------
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${params.trace_report_suffix}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${params.trace_report_suffix}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${params.trace_report_suffix}.txt"
           fields  = 'task_id,hash,name,status,exit,realtime,%cpu,peak_rss,rchar,wchar' }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${params.trace_report_suffix}.html" }
