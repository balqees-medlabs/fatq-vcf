/*
 * Reference bundle layout under params.refdir (populated by `-entry PREPARE_REFERENCES`).
 * GRCh38 no-alt + hs38d1 decoy analysis set; GATK hg38 resource bundle; Broad chrM resources.
 */

params {
    // Genome
    fasta              = "${params.refdir}/GCA_000001405.15_GRCh38_no_alt_plus_hs38d1_analysis_set.fna"
    fasta_fai          = "${params.fasta}.fai"
    fasta_dict         = "${params.refdir}/GCA_000001405.15_GRCh38_no_alt_plus_hs38d1_analysis_set.dict"
    bwa_index          = "${params.refdir}/bwa_index"           // dir with <fasta basename>.{0123,amb,ann,bwt.2bit.64,pac}
    str_table          = "${params.refdir}/GRCh38.str_table.zip" // GATK ComposeSTRTableFile, for DRAGEN mode

    // BQSR known sites (GATK hg38 bundle)
    dbsnp              = "${params.refdir}/gatk_bundle/Homo_sapiens_assembly38.dbsnp138.vcf.gz"
    dbsnp_tbi          = "${params.dbsnp}.tbi"
    mills              = "${params.refdir}/gatk_bundle/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
    mills_tbi          = "${params.mills}.tbi"
    known_indels       = "${params.refdir}/gatk_bundle/Homo_sapiens_assembly38.known_indels.vcf.gz"
    known_indels_tbi   = "${params.known_indels}.tbi"

    // Calling regions
    wgs_calling_regions = "${params.refdir}/gatk_bundle/wgs_calling_regions.hg38.interval_list"
    intervals           = null   // optional override: BED/interval_list applied to every sample (WES BED comes from samplesheet)

    // Contamination / sex
    // Shipped inside the verifybamid2 BioContainer (verified 2026-11-15); prefix of .UD/.mu/.bed/.V
    verifybamid_svd     = "/usr/local/share/verifybamid2-2.0.3-0/resource/1000g.phase3.100k.b38.vcf.gz.dat"
    somalier_sites      = "${params.refdir}/somalier/sites.hg38.vcf.gz"

    // Mitochondria (Broad chrM resources)
    mt_fasta                    = "${params.refdir}/chrM/Homo_sapiens_assembly38.chrM.fasta"
    mt_shifted_fasta            = "${params.refdir}/chrM/Homo_sapiens_assembly38.chrM.shifted_by_8000_bases.fasta"
    mt_shiftback_chain          = "${params.refdir}/chrM/ShiftBack.chain"
    mt_blacklist                = "${params.refdir}/chrM/blacklist_sites.hg38.chrM.bed"
    mt_control_region_shifted   = "${params.refdir}/chrM/control_region_shifted.chrM.interval_list"
    mt_non_control_region       = "${params.refdir}/chrM/non_control_region.chrM.interval_list"
}
