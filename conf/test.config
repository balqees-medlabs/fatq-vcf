/*
 * Fast end-to-end regression test: HG002 chr20 + chrM subset (created by PREPARE_REFERENCES --test_data).
 *   nextflow run main.nf -profile docker,test
 */
params {
    input         = "${projectDir}/tests/data/samplesheet_test_wgs.csv"
    outdir        = "${projectDir}/tests/results_wgs"
    scatter_count = 4
    intervals     = "${projectDir}/tests/data/chr20_chrM.interval_list"
    max_cpus      = 16
    max_memory    = '48.GB'
}
cleanup = false
