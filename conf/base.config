/*
 * Resource labels. Sized for one 80-core / 125 GB node; every process picks a label.
 * Each directive is a lazy closure that caps the request at params.max_cpus / max_memory / max_time,
 * evaluated per task so the test profile's smaller limits actually take effect (a map-literal
 * resourceLimits is evaluated eagerly before profiles apply, so it cannot be used here).
 * Retries bump resources once on exit codes typical for OOM / preemption.
 */

process {
    cpus   = { [ 1 * task.attempt, params.max_cpus as int ].min() }
    memory = { 6.GB  * task.attempt < (params.max_memory as nextflow.util.MemoryUnit) ? 6.GB * task.attempt : params.max_memory as nextflow.util.MemoryUnit }
    time   = { 4.h   * task.attempt < (params.max_time   as nextflow.util.Duration)   ? 4.h  * task.attempt : params.max_time   as nextflow.util.Duration }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + 137) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = 1
        memory = { 4.GB  * task.attempt < (params.max_memory as nextflow.util.MemoryUnit) ? 4.GB * task.attempt : params.max_memory as nextflow.util.MemoryUnit }
    }
    withLabel: process_low {
        cpus   = { [ 2 * task.attempt, params.max_cpus as int ].min() }
        memory = { 8.GB  * task.attempt < (params.max_memory as nextflow.util.MemoryUnit) ? 8.GB * task.attempt : params.max_memory as nextflow.util.MemoryUnit }
    }
    withLabel: process_medium {
        cpus   = { [ 4 * task.attempt, params.max_cpus as int ].min() }
        memory = { 16.GB * task.attempt < (params.max_memory as nextflow.util.MemoryUnit) ? 16.GB * task.attempt : params.max_memory as nextflow.util.MemoryUnit }
    }
    withLabel: process_high {
        cpus   = { [ 16 * task.attempt, params.max_cpus as int ].min() }
        memory = { 48.GB * task.attempt < (params.max_memory as nextflow.util.MemoryUnit) ? 48.GB * task.attempt : params.max_memory as nextflow.util.MemoryUnit }
    }
    // Alignment: as much of the node as allowed, one sample at a time.
    withLabel: process_align {
        cpus   = { [ 64, params.max_cpus as int ].min() }
        memory = { 96.GB < (params.max_memory as nextflow.util.MemoryUnit) ? 96.GB : params.max_memory as nextflow.util.MemoryUnit }
        time   = { 12.h  * task.attempt < (params.max_time as nextflow.util.Duration) ? 12.h * task.attempt : params.max_time as nextflow.util.Duration }
    }
    withLabel: process_high_memory {
        memory = { 100.GB < (params.max_memory as nextflow.util.MemoryUnit) ? 100.GB : params.max_memory as nextflow.util.MemoryUnit }
    }
    withLabel: process_long {
        time   = { 24.h  * task.attempt < (params.max_time as nextflow.util.Duration) ? 24.h * task.attempt : params.max_time as nextflow.util.Duration }
    }
    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }
}
