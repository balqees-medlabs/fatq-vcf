/*
 * Resource labels. Sized for one 80-core / 125 GB node; every process picks a label.
 * resourceLimits caps any request (including retry escalation) at the node's limits.
 * Retries bump resources once on exit codes typical for OOM / preemption.
 */

process {
    resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory as nextflow.util.MemoryUnit, time: params.max_time as nextflow.util.Duration ]

    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + 137) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = 1
        memory = { 4.GB  * task.attempt }
    }
    withLabel: process_low {
        cpus   = { 2     * task.attempt }
        memory = { 8.GB  * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 4     * task.attempt }
        memory = { 16.GB * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 16    * task.attempt }
        memory = { 48.GB * task.attempt }
    }
    // Alignment: the whole node, one sample at a time.
    withLabel: process_align {
        cpus   = 64
        memory = 96.GB
        time   = { 12.h  * task.attempt }
    }
    withLabel: process_high_memory {
        memory = { 100.GB * task.attempt }
    }
    withLabel: process_long {
        time   = { 24.h  * task.attempt }
    }
    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }
}
