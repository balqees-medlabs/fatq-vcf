/*
 * WES regression test: HG002 exome chr20 subset.
 *   nextflow run main.nf -profile docker,test_wes
 */
params {
    input         = "${projectDir}/tests/data/samplesheet_test_wes.csv"
    outdir        = "${projectDir}/tests/results_wes"
    scatter_count = 4
    max_cpus      = 16
    max_memory    = '48.GB'
}
cleanup = false
