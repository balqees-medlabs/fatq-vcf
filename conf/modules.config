/*
 * Per-process arguments and publish directories.
 * Tool versions are pinned in conf/containers.config, not here.
 */

process {
    // Nothing is published unless a process below opts in.
    publishDir = [ enabled: false ]

    // ---- Reference preparation (-entry PREPARE_REFERENCES) -------------------
    withName: 'PREPARE_REFERENCES:FETCH_GENOME|PREPARE_REFERENCES:SAMTOOLS_FAIDX|PREPARE_REFERENCES:GATK4_CREATESEQUENCEDICTIONARY|PREPARE_REFERENCES:GATK4_COMPOSESTRTABLEFILE' {
        publishDir = [ path: { params.refdir }, mode: 'copy' ]
    }
    withName: 'PREPARE_REFERENCES:BWAMEM2_INDEX' {
        publishDir = [ path: { "${params.refdir}/bwa_index" }, mode: 'copy' ]
    }
    withName: 'PREPARE_REFERENCES:FETCH_URL|PREPARE_REFERENCES:FETCH_URL_VALIDATION' {
        publishDir = [ path: { "${params.refdir}/${meta.subdir}" }, mode: 'copy' ]
    }
    withName: 'PREPARE_REFERENCES:BGZIP_TABIX' {
        publishDir = [ path: { "${params.refdir}/${meta.subdir}" }, mode: 'copy' ]
    }
    withName: 'PREPARE_REFERENCES:CHRM_INDEX' {
        publishDir = [ path: { "${params.refdir}/chrM" }, mode: 'copy' ]
    }
    withName: 'PREPARE_REFERENCES:GIAB_TEST_SUBSET|PREPARE_REFERENCES:GIAB_TRUTH_SUBSET' {
        publishDir = [ path: { "${projectDir}/tests/data" }, mode: 'copy' ]
    }

    // ---- QC + alignment ----------------------------------------------------
    withName: 'FASTP_BWAMEM' {
        // ext.args → fastp. Light trimming only: adapters + poly-G; no hard quality cut (BWA soft-clips).
        ext.args   = { params.trim_reads
                        ? '--detect_adapter_for_pe --trim_poly_g --length_required 30 --dont_eval_duplication'
                        : '--disable_adapter_trimming --disable_quality_filtering --disable_length_filtering --dont_eval_duplication' }
        // ext.args2 → aligner. -Y: soft-clip supplementary (GATK/Manta best practice); -K: deterministic batching
        ext.args2  = '-K 100000000 -Y'
        publishDir = [ path: { "${params.outdir}/${meta.id}/qc/fastp" }, mode: params.publish_dir_mode,
                       pattern: '*.fastp.{html,json}' ]
    }

    withName: 'SAMTOOLS_MARKDUP' {
        ext.args   = { "-d ${params.markdup_optical_dist} -S" }
        publishDir = [
            [ path: { "${params.outdir}/${meta.id}/alignment" },   mode: params.publish_dir_mode, pattern: '*.{cram,crai}' ],
            [ path: { "${params.outdir}/${meta.id}/qc/markdup" },  mode: params.publish_dir_mode, pattern: '*.markdup.txt' ],
        ]
    }

    withName: 'SAMTOOLS_STATS' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/qc/samtools" }, mode: params.publish_dir_mode ]
    }

    withName: 'MOSDEPTH' {
        ext.args   = '--fast-mode --no-per-base'
        publishDir = [ path: { "${params.outdir}/${meta.id}/qc/mosdepth" }, mode: params.publish_dir_mode ]
    }

    withName: 'VERIFYBAMID2' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/qc/contamination" }, mode: params.publish_dir_mode ]
    }
    withName: 'SOMALIER_RELATE' {
        publishDir = [ path: { "${params.outdir}/somalier" }, mode: params.publish_dir_mode ]
    }
    withName: 'PICARD_COLLECTHSMETRICS' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/qc/hs_metrics" }, mode: params.publish_dir_mode ]
    }
    withName: 'QC_GATES' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/qc" }, mode: params.publish_dir_mode, pattern: '*.qc_summary.tsv' ]
    }

    // ---- BQSR ----------------------------------------------------------------
    withName: 'GATK4_BASERECALIBRATOR' {
        ext.args   = '--use-original-qualities'
        publishDir = [ enabled: false ]
    }
    withName: 'GATK4_APPLYBQSR' {
        ext.args   = '--static-quantized-quals 10 --static-quantized-quals 20 --static-quantized-quals 30 --add-output-sam-program-record --use-original-qualities'
        publishDir = [ enabled: false ]
    }
    withName: 'SAMTOOLS_MERGE_CRAM' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/alignment" }, mode: params.publish_dir_mode,
                       pattern: '*.recal.cram*' ]
    }

    // ---- Germline SNV/indel --------------------------------------------------
    withName: 'GATK4_HAPLOTYPECALLER' {
        ext.args   = '-ERC GVCF --dragen-mode true -G StandardAnnotation -G StandardHCAnnotation -G AS_StandardAnnotation --native-pair-hmm-threads 4 --smith-waterman FASTEST_AVAILABLE'
        publishDir = [ enabled: false ]
    }
    withName: 'GATK4_MERGEVCFS' {
        ext.prefix = { "${meta.id}.g" }
        publishDir = [ path: { "${params.outdir}/${meta.id}/variants" }, mode: params.publish_dir_mode,
                       pattern: '*.g.vcf.gz*' ]
    }
    withName: 'GATK4_GENOTYPEGVCFS' {
        ext.args   = '-G StandardAnnotation -G AS_StandardAnnotation'
        publishDir = [ enabled: false ]
    }
    withName: 'BCFTOOLS_STATS' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/variants/stats" }, mode: params.publish_dir_mode ]
    }
    withName: 'GATK4_VARIANTFILTRATION' {
        // DRAGEN-GATK single-sample hard filter
        ext.args   = '--filter-expression "QUAL < 10.4139" --filter-name "DRAGENHardQUAL"'
        ext.prefix = { "${meta.id}.filtered" }
        publishDir = [ path: { "${params.outdir}/${meta.id}/variants" }, mode: params.publish_dir_mode ]
    }

    // ---- Mitochondria --------------------------------------------------------
    withName: 'MITO_MUTECT2.*' {
        ext.args   = '--mitochondria-mode --max-reads-per-alignment-start 75 --max-mnp-distance 0 --annotation StrandBiasBySample'
        publishDir = [ enabled: false ]
    }
    withName: 'MITO_MERGE_FILTER' {
        // FilterMutectCalls args (median-autosomal-coverage left default; mito-mode handles VAF)
        ext.args   = '--mitochondria-mode --max-alt-allele-count 4 --min-allele-fraction 0.01'
        publishDir = [ path: { "${params.outdir}/${meta.id}/mito" }, mode: params.publish_dir_mode,
                       pattern: '*.chrM.final.vcf.gz*' ]
    }
    withName: 'HAPLOCHECK' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/mito" }, mode: params.publish_dir_mode, pattern: '*.haplocheck*.txt' ]
    }
    withName: 'HAPLOGREP3' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/mito" }, mode: params.publish_dir_mode, pattern: '*.haplogroup.txt' ]
    }

    // ---- SV / CNV -------------------------------------------------------------
    withName: 'MANTA_GERMLINE' {
        ext.args   = { meta.seq_type == 'wes' ? '--exome' : '' }
        publishDir = [ path: { "${params.outdir}/${meta.id}/sv_cnv/manta" }, mode: params.publish_dir_mode ]
    }
    withName: 'CNVPYTOR_.*' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/sv_cnv/cnvpytor" }, mode: params.publish_dir_mode ]
    }

    // ---- Report ---------------------------------------------------------------
    withName: 'MULTIQC' {
        publishDir = [ path: { "${params.outdir}/multiqc" }, mode: params.publish_dir_mode ]
    }
}
