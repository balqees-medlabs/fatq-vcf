/*
 * THE single place where tool versions are pinned.
 * Tags verified against quay.io / Docker Hub on 2026-11-15 (see docs/PIPELINE_PLAN.md §1).
 * Do not bump bwa-mem3 without re-running the Phase 6 aligner head-to-head.
 */

process {
    // Local image (containers/align/Dockerfile): fastp 1.4.0 + bwa-mem3 0.17.0 + bwa-mem2 2.3 + samtools 1.25.
    // Build once: docker build --network=host -t fatqvcf/align:0.1.0 containers/align
    withName: 'FASTP_BWAMEM|BWAMEM2_INDEX|CHRM_INDEX|GIAB_TEST_SUBSET' { container = 'fatqvcf/align:0.1.0' }

    withName: 'SAMTOOLS_.*'                 { container = 'quay.io/biocontainers/samtools:1.25--h9dcdb79_0' }
    withName: 'BCFTOOLS_.*|BGZIP_TABIX|GIAB_TRUTH_SUBSET' { container = 'quay.io/biocontainers/bcftools:1.25--h118bc1c_1' }
    withName: 'MOSDEPTH'                    { container = 'quay.io/biocontainers/mosdepth:0.3.14--h87be163_2' }
    withName: 'VERIFYBAMID2'                { container = 'quay.io/biocontainers/verifybamid2:2.0.3--hc004090_0' }
    withName: 'SOMALIER_.*'                 { container = 'quay.io/biocontainers/somalier:0.3.7--h5205c93_0' }

    // Official Broad image: includes the Python/PyTorch env needed by NVScoreVariants & gCNV.
    withName: 'GATK4_.*|PICARD_.*'          { container = 'broadinstitute/gatk:4.6.2.0' }

    withName: 'MANTA_.*'                    { container = 'quay.io/biocontainers/manta:1.6.0--py27h9948957_6' }
    withName: 'CNVPYTOR_.*'                 { container = 'quay.io/biocontainers/cnvpytor:1.3.2--pyhdfd78af_0' }
    withName: 'ANNOTSV'                     { container = 'quay.io/biocontainers/annotsv:3.5.10--hdfd78af_0' }

    withName: 'HAPLOCHECK'                  { container = 'quay.io/biocontainers/haplocheck:1.3.3--h2a3209d_2' }
    withName: 'HAPLOGREP3'                  { container = 'quay.io/biocontainers/haplogrep3:3.2.2--hdfd78af_1' }

    withName: 'MULTIQC|QC_GATES'            { container = 'quay.io/biocontainers/multiqc:1.35--pyhdfd78af_2' }

    // Validation (Phase 6)
    withName: 'HAPPY'                       { container = 'quay.io/biocontainers/hap.py:0.3.15--py27hcb73b3d_0' }
    withName: 'TRUVARI_.*'                  { container = 'quay.io/biocontainers/truvari:5.5.0--pyhdfd78af_1' }
}
