{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/balqees-medlabs/fatq-vcf/main/nextflow_schema.json",
    "title": "fatq-vcf pipeline parameters",
    "description": "Germline WGS/WES pipeline: FASTQ to SNV/indel, mitochondrial and CNV/SV VCFs on GRCh38",
    "type": "object",
    "defs": {
        "input_output": {
            "title": "Input/output",
            "type": "object",
            "properties": {
                "input": {
                    "type": "string",
                    "format": "file-path",
                    "pattern": "^\\S+\\.csv$",
                    "description": "Samplesheet CSV: sample,lane,fastq_1,fastq_2,seq_type,capture_bed,sex"
                },
                "outdir": { "type": "string", "format": "directory-path", "default": "results" },
                "publish_dir_mode": { "type": "string", "default": "copy", "enum": ["copy", "symlink", "link", "rellink", "move"] }
            }
        },
        "entry_points": {
            "title": "Entry points",
            "type": "object",
            "properties": {
                "prepare_references": { "type": "boolean", "description": "Build the reference bundle instead of running the pipeline" },
                "validate": { "type": "boolean", "description": "Run the hap.py/truvari validation workflow" },
                "pon_build": { "type": "boolean", "description": "Build a WES gCNV panel of normals" }
            }
        },
        "tools": {
            "title": "Tool selection",
            "type": "object",
            "properties": {
                "aligner": { "type": "string", "default": "bwamem3", "enum": ["bwamem3", "bwamem2"] },
                "bwamem3_compat": { "type": "string", "default": "bwa-mem2" },
                "skip_bqsr": { "type": "boolean" },
                "skip_mito": { "type": "boolean" },
                "skip_sv_cnv": { "type": "boolean" },
                "trim_reads": { "type": "boolean", "default": true },
                "scatter_count": { "type": "integer", "default": 20, "minimum": 1 },
                "markdup_optical_dist": { "type": "integer", "default": 2500 },
                "wes_padding": { "type": "integer", "default": 100 }
            }
        },
        "qc_gates": {
            "title": "QC gates",
            "type": "object",
            "properties": {
                "max_contamination": { "type": "number", "default": 0.03 },
                "min_mean_cov_wgs": { "type": "number", "default": 25 },
                "min_target_cov_wes": { "type": "integer", "default": 20 },
                "min_target_frac_wes": { "type": "number", "default": 0.9 },
                "max_duplication": { "type": "number", "default": 0.25 }
            }
        },
        "resources": {
            "title": "Max resources",
            "type": "object",
            "properties": {
                "max_cpus": { "type": "integer", "default": 80 },
                "max_memory": { "type": "string", "default": "115.GB", "pattern": "^\\d+(\\.\\d+)?\\.?(K|M|G|T)?B$" },
                "max_time": { "type": "string", "default": "72.h" }
            }
        }
    },
    "allOf": [
        { "$ref": "#/defs/input_output" },
        { "$ref": "#/defs/entry_points" },
        { "$ref": "#/defs/tools" },
        { "$ref": "#/defs/qc_gates" },
        { "$ref": "#/defs/resources" }
    ]
}
