nextflow_workflow {

    name "parseSamplesheet"
    script "tests/lib/samplesheet_harness.nf"
    workflow "SAMPLESHEET_HARNESS"

    test("parses a valid WGS+WES samplesheet into two lane-level entries") {
        when {
            workflow {
                """
                input[0] = file("\${projectDir}/tests/data/fixtures/sheet_ok.csv")
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.rows.size() == 2
            // meta is element 0 of each [meta, reads] tuple
            def metas = workflow.out.rows.collect { it[0] }
            def wgs = metas.find { it.seq_type == 'wgs' }
            def wes = metas.find { it.seq_type == 'wes' }
            assert wgs.sex == 'female' && wgs.single_end == false
            assert wes.capture_bed != null
        }
    }

    test("rejects an invalid seq_type") {
        when {
            workflow {
                """
                input[0] = file("\${projectDir}/tests/data/fixtures/sheet_bad_seqtype.csv")
                """
            }
        }
        then {
            assert workflow.failed
        }
    }
}
